[32m+[m[32mdef generate_conflicting_truth_dataset(n_samples, n_params, model_specs, noise_std=0.0, seed=None, nc_path=None):[m
[32m+[m[32m    """The multi-model structural-error scenario: a set of x values maps to y_1[m
[32m+[m[32m    given model m_1, and the *same* x values also map to y_2 given a[m
[32m+[m[32m    different model m_2 -- m_1 and m_2 share the same parameter space (same[m
[32m+[m[32m    n_params), so the training ensemble (X, Y) is a single valid table with[m
[32m+[m[32m    Y = [Y_1 | Y_2 | ...] as column-blocks, one per model. The conflict is in[m
[32m+[m[32m    the truth: each model's y_true is generated from its *own*, independently[m
[32m+[m[32m    sampled x_true_i rather than one shared x_true -- so a calibration[m
[32m+[m[32m    exercise handed the joint y_true has no single x that can reproduce every[m
[32m+[m[32m    block, which is the point (this is what "no parameter values satisfy y_1[m
[32m+[m[32m    and y_2 given m_1 and m_2" looks like as data).[m
[32m+[m
[32m+[m[32m    model_specs: list of dicts, one per model/output-block:[m
[32m+[m[32m        {"name": "m1" (optional, defaults to "m1", "m2", ...),[m
[32m+[m[32m         "family": "linear" | "exponential" | "polynomial",[m
[32m+[m[32m         "n_outputs": int,[m
[32m+[m[32m         "structure": structure kwarg for that family's generator (default "full";[m
[32m+[m[32m             ignored -- always "full" -- for polynomial, whose own knobs are[m
[32m+[m[32m             degree/n_pairs/etc.),[m
[32m+[m[32m         "structure_kwargs": dict of kwargs for that family's coefficient generator}[m
[32m+[m[32m    See _family_generate_coefficients for which families are supported and how[m
[32m+[m[32m    to add more.[m
[32m+[m
[32m+[m[32m    Returns a dataset dict shaped like generate_structural_regime_dataset's output[m
[32m+[m[32m    for the parts that don't have a single answer -- x_true/y_true/coefficients[m
[32m+[m[32m    are dicts keyed by model name -- plus:[m
[32m+[m[32m        output_model_label: (n_outputs,) int, which model block each output column[m
[32m+[m[32m            belongs to.[m
[32m+[m[32m        cross_model_mismatch: (n_models, n_models) array; entry [i, j] is the[m
[32m+[m[32m            normalized RMS gap between model i's actual y_true and what model i[m
[32m+[m[32m            would predict at model j's x_true (each output normalized by its[m
[32m+[m[32m            ensemble std, same convention as structural_error_level elsewhere).[m
[32m+[m[32m            The diagonal is ~0 (noise_std only) by construction; large[m
[32m+[m[32m            off-diagonal entries are the visible signature of the conflict.[m
[32m+[m[32m    """[m
[32m+[m[32m    rng = np.random.default_rng(seed)[m
[32m+[m[32m    X = sample_X(n_samples, n_params, seed=seed)[m
[32m+[m
[32m+[m[32m    model_names, coefficients_by_model, compute_fns = [], {}, {}[m
[32m+[m[32m    Y_blocks, x_true_by_model, y_true_clean_by_model, y_true_by_model = [], {}, {}, {}[m
[32m+[m[32m    output_model_label_parts, per_model_metadata = [], {}[m
[32m+[m
[32m+[m[32m    for model_idx, spec in enumerate(model_specs):[m
[32m+[m[32m        name = spec.get("name", f"m{model_idx + 1}")[m
[32m+[m[32m        family = spec["family"][m
[32m+[m[32m        n_outputs_i = spec["n_outputs"][m
[32m+[m[32m        structure = spec.get("structure", "full")[m
[32m+[m[32m        structure_kwargs = spec.get("structure_kwargs", {})[m
[32m+[m[32m        model_seed = int(rng.integers(2**32))[m
[32m+[m[32m        true_seed = int(rng.integers(2**32))[m
[32m+[m
[32m+[m[32m        coefficients_i, paras_to_vary_i = _family_generate_coefficients([m
[32m+[m[32m            family, n_params, n_outputs_i, structure, structure_kwargs, seed=model_seed)[m
[32m+[m[32m        Y_i = _family_compute_Y(family, coefficients_i, X)[m
[32m+[m
[32m+[m[32m        x_true_i = sample_X(1, n_params, seed=true_seed)[0][m
[32m+[m[32m        y_true_i_clean = _family_compute_Y(family, coefficients_i, x_true_i[None, :])[0][m
[32m+[m[32m        y_true_i, _structural_bias_i = add_true_observation_error([m
[32m+[m[32m            y_true_i_clean, Y_i, noise_std=noise_std, seed=true_seed)[m
[32m+[m
[32m+[m[32m        model_names.append(name)[m
[32m+[m[32m        coefficients_by_model[name] = coefficients_i[m
[32m+[m[32m        compute_fns[name] = lambda Xin, c=coefficients_i, f=family: _family_compute_Y(f, c, Xin)[m
[32m+[m[32m        Y_blocks.append(Y_i)[m
[32m+[m[32m        x_true_by_model[name] = x_true_i[m
[32m+[m[32m        y_true_clean_by_model[name] = y_true_i_clean[m
[32m+[m[32m        y_true_by_model[name] = y_true_i[m
[32m+[m[32m        output_model_label_parts.append(np.full(n_outputs_i, model_idx))[m
[32m+[m[32m        per_model_metadata[name] = {[m
[32m+[m[32m            "family": family, "structure": structure, "n_outputs": n_outputs_i,[m
[32m+[m[32m            "paras_to_vary": list(paras_to_vary_i), "seed": model_seed,[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m    Y = np.hstack(Y_blocks)[m
[32m+[m[32m    output_model_label = np.concatenate(output_model_label_parts)[m
[32m+[m
[32m+[m[32m    n_models = len(model_names)[m
[32m+[m[32m    cross_model_mismatch = np.zeros((n_models, n_models))[m
[32m+[m[32m    for i, name_i in enumerate(model_names):[m
[32m+[m[32m        ref_std = Y_blocks[i].std(axis=0)[m
