[32m+[m[32mdef _family_generate_coefficients(family, n_params, n_outputs, structure, structure_kwargs, seed):[m
[32m+[m[32m    """Coefficient generation for one model block of generate_conflicting_truth_dataset,[m
[32m+[m[32m    dispatched by family name. linear/exponential go through the same structure=[m
[32m+[m[32m    full/diag/triu/blocks dispatch as their generate_*_dataset functions[m
[32m+[m[32m    (_generate_structured_coefficients); polynomial always uses its own[m
[32m+[m[32m    generate_matrix_full (degree/pairs/triplets are its own "structure").[m
[32m+[m[32m    Returns (coefficients, paras_to_vary) -- coefficients is a plain array for[m
[32m+[m[32m    linear/exponential, a dict of arrays for polynomial (same shape compute_Y expects).[m
[32m+[m
[32m+[m[32m    Adding a new family here is what makes this generator model-agnostic: any[m
[32m+[m[32m    module exposing a compatible coefficient-generator + compute_Y can be[m
[32m+[m[32m    wired in the same way. ODE/Lorenz96 aren't included since their n_outputs[m
[32m+[m[32m    is a consequence of t_eval rather than chosen directly -- combining those[m
[32m+[m[32m    would need the shared ensemble to carry a time axis too.[m
[32m+[m[32m    """[m
[32m+[m[32m    if family in ("linear", "exponential"):[m
[32m+[m[32m        module = linear if family == "linear" else exponential[m
[32m+[m[32m        coefficients, paras_to_vary, _outputs_to_vary, _extra = _generate_structured_coefficients([m
[32m+[m[32m            module, n_params, n_outputs, structure, structure_kwargs, seed=seed)[m
[32m+[m[32m        return coefficients, paras_to_vary[m
[32m+[m[32m    if family == "polynomial":[m
[32m+[m[32m        result = polynomial.generate_matrix_full(n_params, n_outputs, seed=seed, **(structure_kwargs or {}))[m
[32m+[m[32m        coefficients = {k: v for k, v in result.items() if k != "paras_to_vary"}[m
[32m+[m[32m        return coefficients, result["paras_to_vary"][m
[32m+[m[32m    raise ValueError(f"unknown family: {family!r} (expected one of {_CONFLICTING_TRUTH_FAMILIES})")[m
[32m+[m
