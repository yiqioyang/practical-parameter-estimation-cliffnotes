[32m+[m[32m    if family == "linear":[m
[32m+[m[32m        return linear.compute_Y(X, coefficients)[m
[32m+[m[32m    if family == "exponential":[m
[32m+[m[32m        return exponential.compute_Y(X, coefficients)[m
[32m+[m[32m    if family == "polynomial":[m
[32m+[m[32m        return polynomial.compute_Y([m
[32m+[m[32m            X, coefficients["coefficients_linear"], coefficients["coefficients_quad"],[m
[32m+[m[32m            coefficients["pairs"], coefficients["coefficients_pairs"],[m
[32m+[m[32m            coefficients_cubic=coefficients.get("coefficients_cubic"),[m
[32m+[m[32m            triplets=coefficients.get("triplets"), coefficients_triplets=coefficients.get("coefficients_triplets"))[m
[32m+[m[32m    raise ValueError(f"unknown family: {family!r} (expected one of {_CONFLICTING_TRUTH_FAMILIES})")[m
